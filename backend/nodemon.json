{
  "watch": ["src"],
  "ext": "ts,js,json",
  "ignore": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "node_modules",
    "dist"
  ],
  "exec": "tsx src/index.ts",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 500,
  "verbose": true,
  "legacyWatch": false,
  "events": {
    "restart": "clear && echo 'App restarted'",
    "crash": "echo 'App crashed'"
  },
  "restartable": "rs"
}
